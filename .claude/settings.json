{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git grep *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree *)",
      "Bash(git check-ignore *)",
      "Bash(git add *)",
      "Bash(git mv *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Read",
      "Write",
      "Edit",
      "WebFetch",
      "WebSearch",
      "Skill"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/*)",
      "Read(**/master.key)",
      "Read(**/*.pem)",
      "Edit(**/.env)",
      "Edit(~/.aws/credentials)",
      "Edit(~/.ssh/*)"
    ],
    "ask": [
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(git branch -D *)",
      "Bash(curl -X *)",
      "Bash(curl -d *)",
      "Bash(sudo *)",
      "Bash(rm *)",
      "Bash(rm -rf *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)"
    ]
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/custom-shell/status.sh",
    "padding": 0,
    "refreshInterval": 10
  },
  "skillOverrides": {
    "cc-rsg": "off",
    "japanese-tech-writing": "off"
  },
  "enabledPlugins": {
    "evolutionary-naming@kawasima-skills": true,
    "ponytail@ponytail": true,
    "genshijin@genshijin": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "kawasima-skills": {
      "source": {
        "source": "github",
        "repo": "kawasima/evolutionary-naming"
      },
      "autoUpdate": true
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      },
      "autoUpdate": true
    },
    "genshijin": {
      "source": {
        "source": "github",
        "repo": "InterfaceX-co-jp/genshijin"
      },
      "autoUpdate": true
    }
  },
  "language": "Japanese",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
