{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(npm *)",
      "Bash(rails *)",
      "Bash(docker *)",
      "Bash(terraform *)",
      "Bash(make *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Read",
      "Write",
      "Edit",
      "WebFetch",
      "WebSearch",
      "Skill"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/*)",
      "Read(**/master.key)",
      "Read(**/*.pem)",
      "Edit(**/.env)",
      "Edit(~/.aws/credentials)",
      "Edit(~/.ssh/*)"
    ],
    "ask": [
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(git branch -D *)",
      "Bash(curl -X *)",
      "Bash(curl -d *)",
      "Bash(sudo *)",
      "Bash(rm *)",
      "Bash(rm -rf *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/custom-shell/status.sh",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "evolutionary-naming@kawasima-skills": true,
    "ponytail@ponytail": true,
    "genshijin@genshijin": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "kawasima-skills": {
      "source": {
        "source": "github",
        "repo": "kawasima/evolutionary-naming"
      },
      "autoUpdate": true
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      },
      "autoUpdate": true
    },
    "genshijin": {
      "source": {
        "source": "github",
        "repo": "InterfaceX-co-jp/genshijin"
      },
      "autoUpdate": true
    }
  },
  "language": "Japanese",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "model": "claude-fable-5[1m]"
}
